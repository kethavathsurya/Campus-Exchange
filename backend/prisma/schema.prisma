datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  name              String
  profileImage      String?
  department        String?
  isVerified        Boolean           @default(false)
  verificationToken String?
  role              String            @default("STUDENT") // STUDENT, ADMIN
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  listings          Listing[]         @relation("UserListings")
  wishlists         Wishlist[]
  reservations      Reservation[]     @relation("BuyerReservations")
  conversations1    Conversation[]    @relation("UserConversations1")
  conversations2    Conversation[]    @relation("UserConversations2")
  messagesSent      Message[]         @relation("SentMessages")
  reportsSubmitted  LostFoundReport[] @relation("UserReports")
  claimsSubmitted   Claim[]           @relation("ClaimantClaims")
  notifications     Notification[]
  contentReports    ContentReport[]   @relation("ReporterReports")
  moderationActions ModerationAction[]@relation("AdminActions")

  @@index([email])
  @@index([role])
}

model Category {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  description String?
  icon        String?

  listings    Listing[]
  reports     LostFoundReport[]

  @@index([slug])
}

model Listing {
  id          String         @id @default(uuid())
  sellerId    String
  title       String
  description String
  categoryId  String
  listingType String         @default("SELL") // SELL, EXCHANGE, GIVE_AWAY, BUY_REQUEST
  price       Float?
  condition   String         @default("GOOD") // NEW, LIKE_NEW, GOOD, FAIR, USED
  location    String
  status      String         @default("ACTIVE") // ACTIVE, RESERVED, SOLD, EXCHANGED, GIVEN_AWAY, CLOSED, REMOVED
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  seller      User           @relation("UserListings", fields: [sellerId], references: [id], onDelete: Cascade)
  category    Category       @relation(fields: [categoryId], references: [id])
  images      ListingImage[]
  wishlists   Wishlist[]
  reservations Reservation[]
  conversations Conversation[]

  @@index([status])
  @@index([categoryId])
  @@index([sellerId])
  @@index([listingType])
  @@index([createdAt])
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Reservation {
  id        String   @id @default(uuid())
  listingId String
  buyerId   String
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     User     @relation("BuyerReservations", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

model Conversation {
  id            String    @id @default(uuid())
  listingId     String?
  participant1Id String
  participant2Id String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listing       Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participant1  User      @relation("UserConversations1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2  User      @relation("UserConversations2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([listingId, participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([isRead])
  @@index([createdAt])
}

model LostFoundReport {
  id                      String        @id @default(uuid())
  reporterId              String
  reportType              String        // LOST, FOUND
  title                   String
  description             String
  categoryId              String
  location                String
  dateEvent               DateTime
  approximateTime         String?
  distinguishingAttributes String?
  visibleAttributes       String?
  status                  String        @default("LOST") // LOST, FOUND, CLAIMED, RESOLVED, CLOSED
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  reporter                User          @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  category                Category      @relation(fields: [categoryId], references: [id])
  images                  ReportImage[]
  claims                  Claim[]

  @@index([reportType])
  @@index([status])
  @@index([categoryId])
  @@index([reporterId])
  @@index([createdAt])
}

model ReportImage {
  id        String          @id @default(uuid())
  reportId  String
  url       String
  createdAt DateTime        @default(now())

  report    LostFoundReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model Claim {
  id                   String          @id @default(uuid())
  reportId             String
  claimantId           String
  explanation          String
  verificationQuestion String?
  verificationAnswer   String?
  status               String          @default("PENDING") // PENDING, ACCEPTED, REJECTED, WITHDRAWN
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  report               LostFoundReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  claimant             User            @relation("ClaimantClaims", fields: [claimantId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([claimantId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // MESSAGE, RESERVATION, MATCH, CLAIM, SYSTEM
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model ContentReport {
  id          String   @id @default(uuid())
  reporterId  String
  contentType String   // LISTING, REPORT, USER
  targetId    String
  reason      String   // SPAM, SUSPICIOUS, INAPPROPRIATE, MISLEADING, ABUSIVE
  details     String?
  status      String   @default("PENDING") // PENDING, REVIEWED, DISMISSED, ACTIONED
  createdAt   DateTime @default(now())

  reporter    User     @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  actions     ModerationAction[]

  @@index([status])
  @@index([contentType, targetId])
}

model ModerationAction {
  id              String         @id @default(uuid())
  adminId         String
  contentReportId String?
  actionType      String         // REMOVE_CONTENT, DISMISS_REPORT, WARN_USER
  notes           String?
  createdAt       DateTime       @default(now())

  admin           User           @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
  contentReport   ContentReport? @relation(fields: [contentReportId], references: [id], onDelete: SetNull)

  @@index([adminId])
}
